{
  "name": "nexuspro-enterprise",
  "version": "3.0.0",
  "description": "NexusPro Enterprise — Sistema de gestión para talleres mecánicos (Guatemala). PWA multi-taller con Supabase, desplegable en Cloudflare y empaquetable con Electron.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "npx --yes serve@latest -l 8080 .",
    "preview": "npx --yes wrangler dev",
    "predeploy": "npm test && npm run humo:todo && npm run humo:movil",
    "deploy": "npx --yes wrangler deploy",
    "deploy:sin-pruebas": "npx --yes wrangler deploy",
    "electron": "npx --yes electron electron/main.js",
    "build": "echo \"Sitio estático — no requiere build\"",
    "test": "node test/obd/run.js",
    "humo": "node test/humo/correr.mjs",
    "humo:crud": "node test/humo/correr.mjs crud.mjs",
    "humo:venta": "node test/humo/correr.mjs venta.mjs",
    "humo:todo": "node test/humo/correr.mjs humo.mjs crud.mjs venta.mjs permisos.mjs calculos.mjs primeriza.mjs visibles.mjs impresos.mjs app-android.mjs",
    "humo:movil": "node test/humo/correr.mjs --movil humo.mjs visibles.mjs",
    "humo:permisos": "node test/humo/correr.mjs permisos.mjs",
    "humo:calculos": "node test/humo/correr.mjs calculos.mjs",
    "humo:visibles": "node test/humo/correr.mjs visibles.mjs",
    "humo:impresos": "node test/humo/correr.mjs impresos.mjs",
    "humo:app": "node test/humo/correr.mjs app-android.mjs"
  },
  "keywords": [
    "taller",
    "automotriz",
    "erp",
    "pwa",
    "supabase",
    "guatemala",
    "cloudflare"
  ],
  "author": "CM Telecomm GT",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0"
  }
}
